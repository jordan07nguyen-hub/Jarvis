# Copy to .env and fill in what you use. Nothing here is required to start
# the server, but you need at least one provider configured to actually chat.

JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Pin a provider, or leave unset to auto-select by priority:
# claude -> openai -> ollama -> gemini -> openrouter
# JARVIS_AI_PROVIDER=claude

JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o

# Set this to enable offline mode via a local Ollama daemon.
JARVIS_OLLAMA_BASE_URL=
JARVIS_OLLAMA_MODEL=llama3.1

JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-1.5-pro

JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
