# Copy to .env and fill in what you use. Nothing here is required to start
# the server, but you need at least one provider configured to actually chat.

# Loopback-only by default (127.0.0.1) — this is a single-user local
# assistant. Only widen this if you specifically intend to expose it beyond
# your own machine, and put real auth/network controls in front of it if so.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Bearer token clients must send to use /api/chat and /ws/chat. Leave unset
# and one is generated + saved to backend/data/api_token.txt on first run
# (printed to the console) — set it explicitly to pin your own.
# JARVIS_API_TOKEN=

# Origins allowed to call the REST API from a browser. Leave empty (default)
# unless you're deliberately building a web frontend against this backend.
# JARVIS_CORS_ALLOW_ORIGINS=["https://example.com"]

# Pin a provider, or leave unset to auto-select by priority:
# claude -> openai -> ollama -> gemini -> openrouter
# JARVIS_AI_PROVIDER=claude

JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-5
# Lets Claude search the web for news/current facts (server-side, no separate
# search API key needed). Set to false to disable.
JARVIS_ANTHROPIC_WEB_SEARCH=true

JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o

# Set this to enable offline mode via a local Ollama daemon.
JARVIS_OLLAMA_BASE_URL=
JARVIS_OLLAMA_MODEL=llama3.1

JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-1.5-pro

JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
